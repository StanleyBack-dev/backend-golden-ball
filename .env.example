# Copie para .env.development (local). Em produção configure as variáveis na Vercel.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Neon: Dashboard > Connection Details > Connection string (use o branch "dev" localmente)
DATABASE_URL=postgresql://user:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DB_SSL=true
# Migrations rodam automaticamente ao iniciar o servidor
DB_MIGRATIONS_RUN=true
TYPEORM_LOGGING=false

# Segredos (>= 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# VOTER_HASH_SECRET NUNCA deve mudar depois que a votação começar (perde o controle de quem já votou).
VOTER_HASH_SECRET=
# Mesmo valor configurado no BFF (frontend/server)
INTERNAL_API_SECRET=
# Assina a sessão de votação emitida após o login com Google
SESSION_SECRET=
SESSION_TTL_SECONDS=86400

# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web).
# Mesmo valor de VITE_GOOGLE_CLIENT_ID no frontend.
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile (gratuito). Obrigatório em produção; vazio desativa localmente.
TURNSTILE_SECRET_KEY=

VOTING_OPEN=true
# Encerramento: 17h de Brasília do dia da cerimônia da Bola de Ouro (26/10/2026).
# Sempre com fuso explícito (-03:00), senão o servidor (UTC) encerraria 3h antes.
VOTING_CLOSES_AT=2026-10-26T17:00:00-03:00
RESULTS_CACHE_TTL_SECONDS=10

# Rate limit (segundos / requisições por IP)
RATE_LIMIT_DEFAULT_TTL=60
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_VOTE_TTL=600
RATE_LIMIT_VOTE_LIMIT=10

# Estatísticas dos indicados (Highlightly via RapidAPI). A chave só é usada pela
# sincronização diária (npm run stats:sync:dev), nunca pela API.
HIGHLIGHTLY_API_KEY=
PLAYER_STATS_CLUB_SEASON=25/26
PLAYER_STATS_NATIONAL_LEAGUE_ID=1635
PLAYER_STATS_NATIONAL_SEASON=2026
# Janela da Bola de Ouro encerrada: depois de uma carga completa, o job não chama mais a API.
PLAYER_STATS_WINDOW_CLOSED=true
PLAYER_STATS_REQUEST_BUDGET=90
